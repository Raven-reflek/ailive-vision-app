<resources>
    <string name="app_name">AI直播弹幕采集</string>

    <string name="bind_hint">本机将作为专门的弹幕采集设备,用摄像头拍摄另一台直播手机的屏幕。请扫描总部提供的绑定二维码。</string>
    <string name="bind_scan">扫码绑定门店</string>
