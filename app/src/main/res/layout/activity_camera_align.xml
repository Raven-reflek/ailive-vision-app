<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Step1用:实时预览帧。特意不用 CameraX 的 PreviewView(它自己内部按 FILL_CENTER 裁剪画面),
         改成把 ImageAnalysis 吐出来的每一帧位图直接画上来、scaleType=fitCenter(等比缩放不裁剪)——
         这样店员标定时看到的画面,像素级等于 FrameProcessor 真正拿去做透视变换的那张图,
         AlignOverlayView 按同一个 fitCenter 规则换算比例坐标才不会框歪(2026-09-28 修的硬伤,详见该类注释)。 -->
    <ImageView
        android:id="@+id/livePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000" />

    <!-- Step2用:透视纠正后的静态参考图,默认隐藏 -->
    <ImageView
        android:id="@+id/refImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:background="#000000" />

    <!-- 与上面两层完全叠合,尺寸一致,负责画框+手势 -->
    <com.luxofilms.vision.AlignOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#88000000">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="@string/align_step1_title" />

        <TextView
            android:id="@+id/stepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#DDDDDD"
            android:textSize="13.5sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/align_step1_hint" />

        <TextView
            android:id="@+id/sizeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFB020"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="#88000000">

        <Button
            android:id="@+id/btnRetake"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/align_retake" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/align_next" />
    </LinearLayout>
</FrameLayout>
