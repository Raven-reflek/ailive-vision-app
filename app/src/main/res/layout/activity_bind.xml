<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/bind_hint"
            android:textColor="#6B625A" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingVertical="14dp"
            android:text="@string/bind_scan" />

        <Button
            android:id="@+id/btnPickImage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/bind_pick_image" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/bind_manual"
            android:textColor="#6B625A" />

        <EditText
            android:id="@+id/inServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bind_server_hint"
            android:inputType="textUri"
            android:autofillHints="url" />

        <EditText
            android:id="@+id/inStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bind_store_hint"
            android:inputType="text"
            android:autofillHints="username" />

        <EditText
            android:id="@+id/inCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bind_code_hint"
            android:inputType="textVisiblePassword"
            android:autofillHints="password" />

        <Button
            android:id="@+id/btnBind"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bind_do" />

        <TextView
            android:id="@+id/msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#D63D3D"
            android:minHeight="24dp" />
    </LinearLayout>
</ScrollView>
